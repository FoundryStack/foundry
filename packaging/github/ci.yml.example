name: ci

on:
  pull_request:
  push:
    branches:
      - main

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: erlef/setup-beam@v1
        with:
          elixir-version: "1.19.5"
          otp-version: "28.0"
      - uses: actions/setup-node@v4
        with:
          node-version: "25"
      - run: mix deps.get
      - run: mix compile --warnings-as-errors
      - run: mix test
      - run: mix foundry.project.context --check

  package-smoke:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: erlef/setup-beam@v1
        with:
          elixir-version: "1.19.5"
          otp-version: "28.0"
      - uses: actions/setup-node@v4
        with:
          node-version: "25"
      - uses: mlugg/setup-zig@v2
        with:
          version: "0.15.2"
      - run: sudo apt-get update && sudo apt-get install -y xz-utils
      - run: ./scripts/release/build_burrito.sh linux
