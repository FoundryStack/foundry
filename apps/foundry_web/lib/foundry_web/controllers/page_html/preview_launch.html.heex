<div class="min-h-screen bg-neutral text-neutral-content">
  <div class="mx-auto flex min-h-screen max-w-2xl items-center justify-center px-6 py-16">
    <main class="w-full rounded-[28px] border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-info">Preview</p>
      <h1 class="mt-3 text-3xl font-semibold text-white">Starting preview…</h1>
      <p class="mt-4 text-sm leading-7 text-neutral-content/80">
        Waiting for the preview UI to become available at
        <code class="rounded bg-white/10 px-2 py-1 text-info"><%= @target_url %></code>.
      </p>
      <p class="mt-3 text-sm leading-7 text-neutral-content/70">
        This page will redirect automatically as soon as the preview server is ready.
      </p>
    </main>
  </div>
</div>

<script>
  (() => {
    const targetUrl = <%= Phoenix.HTML.raw(Jason.encode!(@target_url)) %>;
    const redirect = () => window.location.replace(targetUrl);

    const retry = () => {
      fetch(targetUrl, { mode: "no-cors", cache: "no-store" })
        .then(redirect)
        .catch(() => window.setTimeout(retry, 500));
    };

    retry();
  })();
</script>
