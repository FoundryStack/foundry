<style>
  :root {
    --launch-bg-dark: #050408;
    --launch-orange: #fd4f00;
    --launch-orange-soft: rgba(253, 79, 0, 0.74);
  }

  #project-launch-root {
    min-height: 100vh;
    background:
      radial-gradient(circle at top, rgba(253, 79, 0, 0.1), transparent 32%),
      var(--launch-bg-dark);
    overflow: hidden;
  }

  #project-launch-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease-in;
    filter: saturate(190%) brightness(150%) contrast(108%);
  }

  #project-launch-shell {
    position: relative;
    z-index: 10;
    display: flex;
    min-height: 100vh;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    transition: opacity 0.5s ease;
  }

  #project-launch-panel {
    width: 100%;
    max-width: 44rem;
    text-align: center;
  }

  #project-launch-logo {
    display: block;
    width: auto;
    height: clamp(5rem, 12vw, 8.5rem);
    margin: 0 auto;
    filter: drop-shadow(0 0 25px rgba(0, 0, 0, 0.9));
  }

  #project-launch-kicker {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.38em;
    text-transform: uppercase;
  }

  #project-launch-state {
    margin-top: 0.85rem;
    color: white;
    font-size: clamp(0.92rem, 1.7vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #project-launch-title {
    margin-top: 1rem;
    color: white;
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 600;
    line-height: 1.1;
  }

  #project-launch-message {
    margin: 1rem auto 0;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1rem;
    line-height: 1.8;
  }

  #project-launch-log {
    margin: 2rem auto 0;
    max-width: 42rem;
    max-height: 16rem;
    overflow: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.5rem;
    background: rgba(255, 255, 255, 0.04);
    padding: 1rem 1.1rem;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.76rem;
    line-height: 1.75;
    text-align: left;
    white-space: pre-wrap;
    word-break: break-word;
    backdrop-filter: blur(14px);
  }
</style>

<div id="project-launch-root">
  <canvas id="project-launch-canvas"></canvas>

  <main id="project-launch-shell">
    <section id="project-launch-panel">
      <img id="project-launch-logo" src={~p"/images/foundry-logo.png"} alt="Foundry Logo" />
      <p id="project-launch-kicker">Project Launch</p>
      <p id="project-launch-state">Waiting for launch updates</p>
      <h1 id="project-launch-title">Preparing project…</h1>
      <p id="project-launch-message">Foundry is getting the selected project ready.</p>
      <pre id="project-launch-log">Waiting for launch updates…</pre>
    </section>
  </main>
</div>

<script>
  (() => {
    const targetUrl = <%= Phoenix.HTML.raw(Jason.encode!(@target_url)) %>;
    const canvasEl = document.getElementById("project-launch-canvas");
    const logoEl = document.getElementById("project-launch-logo");
    const titleEl = document.getElementById("project-launch-title");
    const messageEl = document.getElementById("project-launch-message");
    const stateEl = document.getElementById("project-launch-state");
    const logEl = document.getElementById("project-launch-log");
    const shellEl = document.getElementById("project-launch-shell");
    let pollTimer = null;
    let fireTimer = null;

    const statusLabel = value =>
      String(value || "")
        .replace(/_/g, " ")
        .trim();

    const applyStateLabel = status => {
      const state = statusLabel(status.state || "idle");
      const step = statusLabel(status.step || "");
      stateEl.textContent = [state, step].filter(Boolean).join(" • ") || "waiting for launch updates";
    };

    const schedulePoll = delayMs => {
      window.clearTimeout(pollTimer);
      pollTimer = window.setTimeout(pollStatus, delayMs);
    };

    const fadeAndRedirect = () => {
      shellEl.style.opacity = "0";
      window.setTimeout(() => window.location.replace(targetUrl), 420);
    };

    const loadPatchedWebGLFluid = async () => {
      if (window.WebGLFluid) return;

      const response = await fetch("https://cdn.jsdelivr.net/npm/webgl-fluid@0.3.0/dist/webgl-fluid.umd.js");
      let source = await response.text();

      source = source.replace("o.color=it()", "o.color=p.SPLAT_COLOR||it()");
      source = source.replace("N.forEach(s=>{s.color=it()})", "N.forEach(s=>{s.color=p.SPLAT_COLOR||it()})");
      source = source.replace(
        "const a=it();a.r*=10,a.g*=10,a.b*=10;",
        "const a=p.SPLAT_COLOR?{...p.SPLAT_COLOR}:it();if(!p.SPLAT_COLOR){a.r*=10,a.g*=10,a.b*=10;}"
      );

      window.eval(source);
    };

    const startFireBackdrop = async () => {
      try {
        await loadPatchedWebGLFluid();

        window.WebGLFluid(canvasEl, {
          TRIGGER: "hover",
          IMMEDIATE: false,
          AUTO: false,
          SIM_RESOLUTION: 128,
          DYE_RESOLUTION: 1024,
          DENSITY_DISSIPATION: 0.97,
          VELOCITY_DISSIPATION: 0.96,
          PRESSURE: 0.8,
          CURL: 10,
          SPLAT_RADIUS: 0.04,
          SPLAT_FORCE: 820,
          SHADING: true,
          SPLAT_COLOR: { r: 1.65, g: 0.34, b: 0.03 },
          COLORFUL: false,
          TRANSPARENT: true,
          BLOOM: true,
          BLOOM_ITERATIONS: 8,
          BLOOM_RESOLUTION: 256,
          BLOOM_INTENSITY: 0.18,
          BLOOM_THRESHOLD: 0.7,
          SUNRAYS: false
        });

        window.setTimeout(() => {
          canvasEl.style.opacity = "1";
        }, 100);

        let time = 0;
        let pointerPrimed = false;

        fireTimer = window.setInterval(() => {
          if (!logoEl) return;

          const rect = logoEl.getBoundingClientRect();

          if (rect.width === 0) return;

          time += 0.13;

          const centerX = rect.left + rect.width / 2;
          const spread = rect.width * 0.08;
          const startX = centerX + Math.sin(time) * spread + Math.sin(time * 1.7) * (spread * 0.15);
          const startY = rect.top + rect.height * 0.8;
          const endY = startY - 7;

          if (!pointerPrimed) {
            canvasEl.dispatchEvent(
              new MouseEvent("mousedown", {
                clientX: startX,
                clientY: startY,
                bubbles: true
              })
            );
            pointerPrimed = true;
          }

          canvasEl.dispatchEvent(
            new MouseEvent("mousemove", {
              clientX: startX,
              clientY: startY,
              bubbles: true
            })
          );

          canvasEl.dispatchEvent(
            new MouseEvent("mousemove", {
              clientX: startX + (Math.random() - 0.5) * 0.6,
              clientY: endY,
              bubbles: true
            })
          );
        }, 60);
      } catch (_error) {
        canvasEl.remove();
      }
    };

    const renderStatus = status => {
      const state = String(status.state || "idle");
      applyStateLabel(status);

      if (status.logs && status.logs !== "") {
        const pinned = logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 32;
        logEl.textContent = status.logs;
        if (pinned || logEl.dataset.pinned !== "false") {
          logEl.scrollTop = logEl.scrollHeight;
          logEl.dataset.pinned = "true";
        }
      } else if (status.last_error) {
        logEl.textContent = status.last_error;
      } else {
        logEl.textContent = "Waiting for launch updates…";
      }

      if (state === "failed" || status.last_error) {
        titleEl.textContent = "Project launch failed";
        messageEl.textContent = status.last_error || "Foundry could not prepare the selected project.";
        stateEl.textContent = "launch blocked";
        schedulePoll(1500);
        return;
      }

      if (state === "ready") {
        titleEl.textContent = "Opening Foundry Studio…";
        messageEl.textContent = status.message || "Your project is ready.";
        stateEl.textContent = "launch ready";
        fadeAndRedirect();
        return;
      }

      titleEl.textContent = "Preparing project…";
      messageEl.textContent = status.message || "Working through the selected project setup.";
      schedulePoll(1000);
    };

    logEl.addEventListener("scroll", () => {
      const pinned = logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 32;
      logEl.dataset.pinned = pinned ? "true" : "false";
    });

    const pollStatus = () => {
      fetch("/project-status", { cache: "no-store" })
        .then(response => response.json())
        .then(renderStatus)
        .catch(() => {
          titleEl.textContent = "Project status unavailable";
          messageEl.textContent = "Could not read launch progress from Foundry.";
          stateEl.textContent = "status unavailable";
          schedulePoll(1500);
        });
    };

    startFireBackdrop();
    pollStatus();
  })();
</script>
