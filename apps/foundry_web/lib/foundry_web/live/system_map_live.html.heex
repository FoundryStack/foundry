<div class="foundry-map-layout flex" data-theme="dark">
  <!-- Sidebar (214px) -->
  <aside class="foundry-sidebar menu bg-base-200 border-r border-base-300">
    <input id="fm-search" class="input input-sm w-full mb-2 mx-1" placeholder="Search…" />
    <div class="flex flex-col gap-1 text-xs text-base-content/50 px-2 mb-2">
      <span><%= Enum.count(@all_nodes) %> modules</span>
      <span class="text-warning"><%= @gap_count %> gaps</span>
      <span class="text-info"><%= @migration_count %> migrations</span>
    </div>
    <ul id="fm-sidebar-list">
      <%= for {domain, nodes} <- @nodes_by_domain do %>
        <li class="menu-title"><%= domain %></li>
        <%= for node <- nodes do %>
          <li data-node-id={node["id"]}>
            <a class="flex items-center gap-2 text-xs">
              <span class="badge badge-xs"><%= abbr_type(node["type"]) %></span>
              <span class="truncate flex-1"><%= node["id"] %></span>
              <!-- Status pip: gap/sensitive/else -->
              <span class={pip_class(node)}></span>
            </a>
          </li>
        <% end %>
      <% end %>
    </ul>
  </aside>

  <!-- Canvas (flex-1) -->
  <div class="flex-1 relative overflow-hidden foundry-map-canvas">
    <%= if @context_json do %>
      <div id="foundry-graph"
           phx-hook="SystemMap"
           data-context={@context_json}
           style="width:100%;height:100%"></div>
    <% else %>
      <div class="flex items-center justify-center h-full">
        <p class="text-base-content/60">
          No modules found. Run <code>mix compile</code> in your project directory.
        </p>
      </div>
    <% end %>
    <!-- Hover card (hidden, positioned by JS) -->
    <div id="fm-hover-card" class="hidden absolute z-50 bg-base-100 border border-base-300 rounded p-2 text-xs shadow-lg" style="pointer-events:none"></div>
  </div>

  <!-- Drawer (slides in from right) -->
  <div id="fm-drawer" class="bg-base-200 border-l border-base-300 flex flex-col overflow-hidden transition-all" style="width:0">
    <div class="tabs tabs-border flex-none px-2 pt-2">
      <button class="tab tab-active" data-tab="details">Details</button>
      <button class="tab" data-tab="flow">Flow</button>
      <button class="tab" data-tab="actions">Actions</button>
      <button class="tab hidden" data-tab="auth">Authorization</button>
      <button id="fm-drawer-close" class="ml-auto btn btn-xs btn-ghost">✕</button>
    </div>
    <div id="fm-panel-details" class="flex-1 overflow-y-auto p-3 text-xs"></div>
    <div id="fm-panel-flow"    class="hidden flex-1 overflow-y-auto p-3 text-xs"></div>
    <div id="fm-panel-actions" class="hidden flex-1 overflow-y-auto p-3 text-xs"></div>
    <div id="fm-panel-auth"    class="hidden flex-1 overflow-y-auto p-3 text-xs"></div>
  </div>
</div>
