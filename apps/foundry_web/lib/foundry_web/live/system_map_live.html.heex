<div class="fm-workspace" data-theme="dark">
  <aside class="fm-sidebar" id="fm-sidebar">
    <div class="fm-sidebar-header">
      <span class="fm-brand">FOUNDRY</span>
      <span class="fm-crumb"><%= @project_name || "project" %></span>
    </div>

    <div class="fm-sidebar-tabs" role="tablist">
      <button class={"fm-sidebar-tab #{if @sidebar_tab == :system_map, do: "active"}"} phx-click="set_sidebar_tab" phx-value-tab="system_map">System Map</button>
      <button class={"fm-sidebar-tab #{if @sidebar_tab == :compliance, do: "active"}"} phx-click="set_sidebar_tab" phx-value-tab="compliance">Compliance</button>
      <button class={"fm-sidebar-tab #{if @sidebar_tab == :operations, do: "active"}"} phx-click="set_sidebar_tab" phx-value-tab="operations">Operations</button>
      <button class={"fm-sidebar-tab #{if @sidebar_tab == :test_coverage, do: "active"}"} phx-click="set_sidebar_tab" phx-value-tab="test_coverage">Coverage</button>
    </div>

    <div class="fm-sidebar-body">
      <%= if @sidebar_tab == :system_map do %>
        <input class="fm-sidebar-search" type="text" placeholder="Filter…"
               phx-keyup="filter_nodes" phx-debounce="200" />
        <div class="fm-node-list" id="fm-node-list">
          <%= for {domain, nodes} <- @nodes_by_domain do %>
            <div class="fm-domain-header"><%= domain %></div>
            <%= for node <- nodes do %>
              <button class="fm-node-item" data-node-id={node["id"]}>
                <span class={"fm-type-badge fm-badge-#{node["type"]}"}><%= abbr_type(node["type"]) %></span>
                <span class="fm-node-name"><%= node["id"] %></span>
                <span class={"fm-pip #{pip_status(node)}"}></span>
              </button>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= if @sidebar_tab == :compliance do %>
        <div class="fm-placeholder">Compliance view coming soon</div>
      <% end %>
      <%= if @sidebar_tab == :operations do %>
        <div class="fm-placeholder">Operations view coming soon</div>
      <% end %>
      <%= if @sidebar_tab == :test_coverage do %>
        <div class="fm-placeholder">Test coverage view coming soon</div>
      <% end %>
    </div>

    <div class="fm-sidebar-resize-handle" id="sidebar-resize-handle"></div>
  </aside>

  <div class="fm-central">
    <div class="fm-lensbar">
      <button class={"fm-lens-btn #{if @lens == :default, do: "active"}"} phx-click="set_lens" phx-value-lens="default">
        <span class="fm-dot fm-dot-primary"></span> Default
      </button>
      <button class={"fm-lens-btn #{if @lens == :trc, do: "active"}"} phx-click="set_lens" phx-value-lens="trc">
        <span class="fm-dot fm-dot-scenario"></span> Scenario
      </button>
      <button class={"fm-lens-btn #{if @lens == :auth, do: "active"}"} phx-click="set_lens" phx-value-lens="auth">
        <span class="fm-dot fm-dot-auth"></span> Auth
      </button>
      <button class={"fm-lens-btn #{if @lens == :cfg, do: "active"}"} phx-click="set_lens" phx-value-lens="cfg">
        <span class="fm-dot fm-dot-config"></span> Config
      </button>
      <div class="fm-lensbar-spacer"></div>
      <button class={"fm-view-btn #{if @system_map_view == :table, do: "active"}"} phx-click="toggle_view">
        <%= if @system_map_view == :graph, do: "Graph", else: "Table" %>
      </button>
      <button class="fm-icon-btn" phx-click="toggle_feed" title="Activity ⌘\">⊕</button>
    </div>

    <div class="fm-content">
      <div class={"fm-drawer #{if @drawer_open, do: "open"}"} id="fm-drawer">
        <div class="fm-drawer-tabs">
          <button class={"fm-drawer-tab #{if @drawer_tab == :details, do: "active"}"} data-tab="details" phx-click="set_drawer_tab" phx-value-tab="details">Details</button>
          <button class={"fm-drawer-tab #{if @drawer_tab == :flow, do: "active"}"} data-tab="flow" phx-click="set_drawer_tab" phx-value-tab="flow">Flow</button>
          <button class={"fm-drawer-tab #{if @drawer_tab == :shortcuts, do: "active"}"} data-tab="actions" phx-click="set_drawer_tab" phx-value-tab="shortcuts">Shortcuts</button>
          <button class={"fm-drawer-tab #{if @drawer_tab == :authorization, do: "active"}"} data-tab="auth" phx-click="set_drawer_tab" phx-value-tab="authorization">Auth</button>
          <button class="fm-drawer-close" id="fm-drawer-close" phx-click="close_drawer">×</button>
        </div>
        <div class="fm-drawer-body" id="fm-panel-details"></div>
        <div class="fm-drawer-body hidden" id="fm-panel-flow"></div>
        <div class="fm-drawer-body hidden" id="fm-panel-actions"></div>
        <div class="fm-drawer-body hidden" id="fm-panel-auth"></div>
      </div>

      <div class="fm-canvas" phx-hook="SystemMap" id="system-map" data-context={@context_json} phx-update="ignore">
        <div id="fm-hover-card" class="hidden"></div>
      </div>
    </div>
  </div>

  <div class={"fm-feed #{if @feed_open, do: "open"}"} id="fm-feed">
    <div class="fm-feed-header">
      <span class="fm-feed-title">Activity</span>
      <button class="fm-icon-btn" phx-click="toggle_feed">×</button>
    </div>
    <div class="fm-feed-tabs">
      <button class={"fm-feed-tab #{if @feed_tab == :feed, do: "active"}"} phx-click="set_feed_tab" phx-value-tab="feed">Feed</button>
      <button class={"fm-feed-tab #{if @feed_tab == :copilot, do: "active"}"} phx-click="set_feed_tab" phx-value-tab="copilot">Copilot</button>
    </div>
    <div class="fm-feed-body" id="feed-body"></div>
    <div class="fm-feed-input">
      <textarea class="fm-feed-textarea" rows="2" placeholder="Ask anything…"
                phx-keydown="feed_keydown"></textarea>
      <div class="fm-feed-hint">⏎ send · ⇧⏎ newline</div>
    </div>
  </div>
</div>
