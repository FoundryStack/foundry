<div class="fm-workspace flex h-screen w-full overflow-hidden bg-base-100" data-theme="dark">
  <aside
    class="fm-sidebar relative flex h-screen min-w-[160px] max-w-[400px] shrink-0 select-none flex-col overflow-hidden border-r border-base-300 bg-base-200"
    id="fm-sidebar"
    style={panel_width_style("--foundry-sidebar-width", true, 240)}
  >
    <div class="flex shrink-0 items-center gap-1.5 border-b border-base-300 px-3 pb-2 pt-2.5">
      <span class="text-sm font-bold uppercase tracking-[0.08em] text-base-content">
        FOUNDRY
      </span>
      <span class="ml-auto text-xs text-neutral-content">{@project_name || "project"}</span>
    </div>

    <div class="flex shrink-0 gap-0.5 border-b border-base-300 px-2" role="tablist">
      <button
        class="fm-sidebar-tab cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-2 py-2 text-xs font-medium uppercase tracking-[0.04em] text-neutral-content transition-colors hover:text-base-content data-[active=true]:border-primary data-[active=true]:text-secondary"
        data-active={@sidebar_tab == :system_map}
        phx-click="set_sidebar_tab"
        phx-value-tab="system_map"
      >
        System Map
      </button>
      <button
        class="fm-sidebar-tab cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-2 py-2 text-xs font-medium uppercase tracking-[0.04em] text-neutral-content transition-colors hover:text-base-content data-[active=true]:border-primary data-[active=true]:text-secondary"
        data-active={@sidebar_tab == :compliance}
        phx-click="set_sidebar_tab"
        phx-value-tab="compliance"
      >
        Compliance
      </button>
      <button
        class="fm-sidebar-tab cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-2 py-2 text-xs font-medium uppercase tracking-[0.04em] text-neutral-content transition-colors hover:text-base-content data-[active=true]:border-primary data-[active=true]:text-secondary"
        data-active={@sidebar_tab == :operations}
        phx-click="set_sidebar_tab"
        phx-value-tab="operations"
      >
        Operations
      </button>
      <button
        class="fm-sidebar-tab cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-2 py-2 text-xs font-medium uppercase tracking-[0.04em] text-neutral-content transition-colors hover:text-base-content data-[active=true]:border-primary data-[active=true]:text-secondary"
        data-active={@sidebar_tab == :test_coverage}
        phx-click="set_sidebar_tab"
        phx-value-tab="test_coverage"
      >
        Coverage
      </button>
    </div>

    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
      <%= if @sidebar_tab == :system_map do %>
        <input
          class="fm-sidebar-search m-2 w-[calc(100%-1rem)] box-border rounded-field border border-base-300/80 bg-base-300 px-2 py-1 text-sm text-base-content outline-none focus:border-primary"
          type="text"
          placeholder="Filter…"
          phx-keyup="filter_nodes"
          phx-debounce="200"
        />
        <div class="fm-node-list flex flex-col" id="fm-node-list">
          <%= for {domain, nodes} <- @nodes_by_domain do %>
            <div class="flex items-center gap-1.5 px-3 pb-0.5 pt-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-neutral-content/50">
              <span>{domain}</span>
              <span class="h-px flex-1 bg-base-300"></span>
            </div>
            <%= for node <- nodes do %>
              <button
                class="fm-node-item group flex h-9 w-full cursor-pointer items-center gap-2 border-0 border-l-2 border-transparent bg-transparent px-3 text-left transition-colors hover:bg-base-300 data-[selected=true]:border-primary data-[selected=true]:bg-primary/10"
                data-node-id={node["id"]}
              >
                <span
                  class="fm-type-badge flex size-6 shrink-0 items-center justify-center rounded-[3px] bg-[var(--badge-bg)] text-xs font-bold text-[var(--badge-fg)]"
                  style={type_badge_style(node["type"])}
                >
                  {abbr_type(node["type"])}
                </span>
                <span class="min-w-0 flex-1 truncate text-sm text-neutral-content group-data-[selected=true]:text-base-content">
                  {node["id"]}
                </span>
                <span class={"size-[5px] shrink-0 rounded-full #{pip_status_class(node)}"}></span>
              </button>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <%= if @sidebar_tab == :compliance do %>
        <div class="p-4 text-center text-xs text-neutral-content">
          Compliance view coming soon
        </div>
      <% end %>
      <%= if @sidebar_tab == :operations do %>
        <div class="p-4 text-center text-xs text-neutral-content">
          Operations view coming soon
        </div>
      <% end %>
      <%= if @sidebar_tab == :test_coverage do %>
        <div class="flex flex-col gap-3 overflow-y-auto p-3">
          <% overall = @domain_coverage[:overall_score] || 0 %>
          <% below_threshold = @domain_coverage[:below_threshold] %>

          <div class="rounded-box border border-base-300/80 bg-base-100/60 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-content">
              Domain Coverage Score
            </p>
            <div class="mt-2 space-y-2">
              <%= for domain <- Enum.sort_by(@domain_coverage, &elem(&1, 0), :desc) |> Enum.take(4) do %>
                <% {domain_name, score} = domain %>
                <%= if domain_name not in [:overall_score, :below_threshold] do %>
                  <div class="flex items-center gap-2">
                    <span class="min-w-[70px] text-xs font-medium text-neutral-content">
                      {String.capitalize(to_string(domain_name))}
                    </span>
                    <div class="flex-1 h-2 bg-base-300 rounded-full overflow-hidden">
                      <div
                        class="h-full bg-secondary transition-all"
                        style="width: #{score}%"
                      ></div>
                    </div>
                    <span class="w-10 text-right text-xs text-neutral-content">
                      {round(score)}%
                    </span>
                  </div>
                <% end %>
              <% end %>
            </div>
            <div class="mt-3 border-t border-base-300/50 pt-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-base-content">Overall Score</span>
                <span class={["text-sm font-bold", if(below_threshold, do: "text-warning", else: "text-success")]}>
                  {Float.round(overall, 1)}%
                </span>
              </div>
              <%= if below_threshold do %>
                <p class="mt-1 text-xs text-warning">
                  ⚠ Below 80% target
                </p>
              <% end %>
            </div>
          </div>

          <div class="space-y-2">
            <%= for {category, scenarios} <- @scenarios_by_category do %>
              <details class="group" open>
                <summary class="flex cursor-pointer items-center gap-2 rounded-box border border-base-300/50 bg-base-200/50 px-3 py-2 select-none">
                  <span class="text-xs font-semibold uppercase tracking-[0.08em] text-neutral-content/70">
                    {String.upcase(to_string(category))} ({Enum.count(scenarios)})
                  </span>
                </summary>
                <div class="space-y-1 p-2">
                  <%= for scenario <- scenarios do %>
                    <button
                      class="group/item w-full flex flex-col gap-1 rounded-box border border-transparent bg-base-300/30 p-2 text-left transition-colors hover:bg-base-300/60 data-[selected=true]:border-primary data-[selected=true]:bg-primary/10"
                      data-selected={@selected_scenario_id == scenario.id}
                      phx-click="select_scenario"
                      phx-value-id={scenario.id}
                    >
                      <span class="text-xs font-medium text-base-content">
                        {scenario.name}
                      </span>
                      <div class="flex flex-wrap items-center gap-1">
                        <%= if scenario.level do %>
                          <span class="inline-block rounded text-[10px] border border-info/30 px-1.5 py-0.5 text-info uppercase tracking-[0.08em]">
                            {scenario.level}
                          </span>
                        <% end %>
                        <span class="inline-block rounded text-[10px] border border-base-300/70 px-1.5 py-0.5 text-base-content/65">
                          {Enum.count(scenario.nodes)} covered {if Enum.count(scenario.nodes) == 1, do: "node", else: "nodes"}
                        </span>
                      </div>
                      <%= if not Enum.empty?(scenario.nodes) do %>
                        <div class="flex flex-wrap gap-1">
                          <%= for node_id <- Enum.take(scenario.nodes, 3) do %>
                            <span class="inline-block rounded text-[10px] bg-base-300 px-1.5 py-0.5 text-base-content/70">
                              {node_id |> String.split(".") |> List.last()}
                            </span>
                          <% end %>
                          <%= if Enum.count(scenario.nodes) > 3 do %>
                            <span class="inline-block rounded text-[10px] bg-base-300 px-1.5 py-0.5 text-base-content/70">
                              +{Enum.count(scenario.nodes) - 3}
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                      <%= if not Enum.empty?(scenario.compliance_links) do %>
                        <div class="flex flex-wrap gap-1">
                          <%= for link <- scenario.compliance_links do %>
                            <span class="inline-block rounded text-[10px] bg-warning/20 px-1.5 py-0.5 text-warning font-mono">
                              {link}
                            </span>
                          <% end %>
                        </div>
                      <% end %>
                    </button>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div
      class="absolute inset-y-0 right-0 w-1 cursor-col-resize bg-transparent transition-colors hover:bg-primary"
      id="sidebar-resize-handle"
    >
    </div>
  </aside>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex h-9 shrink-0 items-center gap-1 border-b border-base-300 bg-base-200 px-3">
      <button
        class="flex cursor-pointer items-center gap-1 rounded-selector border border-transparent bg-transparent px-[7px] py-1 text-xs text-neutral-content transition-colors hover:bg-base-300 hover:text-base-content data-[active=true]:border-neutral/80 data-[active=true]:bg-base-300 data-[active=true]:text-base-content"
        data-active={@lens == :default}
        phx-click="set_lens"
        phx-value-lens="default"
      >
        <span class="size-[5px] shrink-0 rounded-full bg-secondary"></span> Default
      </button>
      <button
        class="flex cursor-pointer items-center gap-1 rounded-selector border border-transparent bg-transparent px-[7px] py-1 text-xs text-neutral-content transition-colors hover:bg-base-300 hover:text-base-content data-[active=true]:border-neutral/80 data-[active=true]:bg-base-300 data-[active=true]:text-base-content"
        data-active={@lens == :trc}
        phx-click="set_lens"
        phx-value-lens="trc"
      >
        <span class="size-[5px] shrink-0 rounded-full bg-warning"></span> Scenario
      </button>
      <button
        class="flex cursor-pointer items-center gap-1 rounded-selector border border-transparent bg-transparent px-[7px] py-1 text-xs text-neutral-content transition-colors hover:bg-base-300 hover:text-base-content data-[active=true]:border-neutral/80 data-[active=true]:bg-base-300 data-[active=true]:text-base-content"
        data-active={@lens == :auth}
        phx-click="set_lens"
        phx-value-lens="auth"
      >
        <span class="size-[5px] shrink-0 rounded-full bg-error"></span> Auth
      </button>
      <button
        class="flex cursor-pointer items-center gap-1 rounded-selector border border-transparent bg-transparent px-[7px] py-1 text-xs text-neutral-content transition-colors hover:bg-base-300 hover:text-base-content data-[active=true]:border-neutral/80 data-[active=true]:bg-base-300 data-[active=true]:text-base-content"
        data-active={@lens == :cfg}
        phx-click="set_lens"
        phx-value-lens="cfg"
      >
        <span class="size-[5px] shrink-0 rounded-full bg-purple-400"></span> Config
      </button>
      <div class="flex-1"></div>
      <button
        class="cursor-pointer rounded-selector border border-transparent bg-transparent px-2 py-1 text-xs text-neutral-content transition-colors hover:bg-base-300 hover:text-base-content data-[active=true]:border-primary/30 data-[active=true]:bg-primary/10 data-[active=true]:text-secondary"
        data-active={@system_map_view == :table}
        phx-click="toggle_view"
      >
        {if @system_map_view == :graph, do: "Graph", else: "Table"}
      </button>
      <button
        class="flex cursor-pointer items-center gap-2 rounded-selector border border-transparent bg-transparent px-2 py-1 text-xs font-medium text-neutral-content transition-colors hover:border-primary/20 hover:bg-base-300 hover:text-base-content"
        phx-click="toggle_feed"
        title="Copilot panel ⌘\"
      >
        <span class="size-[6px] shrink-0 rounded-full bg-secondary"></span> Copilot
      </button>
    </div>

    <div class="flex min-h-0 flex-1">
      <div
        class="fm-drawer relative flex shrink-0 flex-col overflow-hidden border-r border-base-300 bg-base-200 transition-[width] duration-200"
        id="fm-drawer"
        data-open={to_string(@drawer_open)}
        style={panel_width_style("--foundry-drawer-width", @drawer_open, 380)}
      >
        <div class="flex shrink-0 items-center border-b border-base-300">
          <button
            class="cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 py-2.5 text-xs text-neutral-content transition-colors hover:text-base-content data-[active=false]:border-base-300 data-[active=true]:border-primary data-[active=true]:text-base-content"
            data-active="false"
            data-tab="details"
          >
            Details
          </button>
          <button
            class="cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 py-2.5 text-xs text-neutral-content transition-colors hover:text-base-content data-[active=false]:border-base-300 data-[active=true]:border-primary data-[active=true]:text-base-content"
            data-active="false"
            data-tab="flow"
          >
            Flow
          </button>
          <button
            class="cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 py-2.5 text-xs text-neutral-content transition-colors hover:text-base-content data-[active=false]:border-base-300 data-[active=true]:border-primary data-[active=true]:text-base-content"
            data-active="false"
            data-tab="actions"
          >
            Shortcuts
          </button>
          <button
            class="cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 py-2.5 text-xs text-neutral-content transition-colors hover:text-base-content data-[active=false]:border-base-300 data-[active=true]:border-primary data-[active=true]:text-base-content"
            data-active="false"
            data-tab="auth"
          >
            Auth
          </button>
          <button
            class="ml-auto mr-2 flex size-8 cursor-pointer items-center justify-center rounded-selector border-0 bg-transparent text-base text-neutral-content hover:bg-base-300 hover:text-base-content transition-colors"
            id="fm-drawer-close"
          >
            ×
          </button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto p-3" id="fm-panel-details"></div>
        <div class="hidden min-h-0 flex-1 overflow-y-auto p-3" id="fm-panel-flow"></div>
        <div class="hidden min-h-0 flex-1 overflow-y-auto p-3" id="fm-panel-actions"></div>
        <div class="hidden min-h-0 flex-1 overflow-y-auto p-3" id="fm-panel-auth"></div>
        <div
          class="absolute inset-y-0 right-0 w-1 cursor-col-resize bg-transparent transition-colors hover:bg-primary"
          id="drawer-resize-handle"
        >
        </div>
      </div>

      <div class="relative min-w-0 flex-1 overflow-hidden bg-base-100">
        <%= if @context_json do %>
          <div
            phx-hook="SystemMap"
            id="system-map"
            data-context={@context_json}
            phx-update="ignore"
            class="size-full"
          >
            <div id="fm-hover-card" class="hidden"></div>
          </div>
        <% else %>
          <div class="flex size-full items-center justify-center p-6">
            <p class="text-base-content/60">
              No modules found. Run <code>mix compile</code> in your project directory.
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div
    class="relative flex shrink-0 flex-col overflow-hidden border-l border-base-300 bg-base-200 transition-[width] duration-200"
    id="fm-feed"
    data-open={to_string(@feed_open)}
    style={panel_width_style("--foundry-feed-width", @feed_open, 360)}
  >
    <div
      class="absolute inset-y-0 left-0 w-1 cursor-col-resize bg-transparent transition-colors hover:bg-primary"
      id="feed-resize-handle"
    >
    </div>
    <div class="flex shrink-0 items-center border-b border-base-300 px-3 py-2">
      <span class="flex-1 text-[11px] font-semibold text-neutral-content">
        {if @feed_tab == :copilot, do: "Copilot", else: "Activity"}
      </span>
      <button
        class="flex size-7 cursor-pointer items-center justify-center rounded-selector border-0 bg-transparent text-neutral-content transition-colors hover:bg-base-300 hover:text-base-content"
        phx-click="toggle_feed"
      >
        ×
      </button>
    </div>
    <div class="flex shrink-0 border-b border-base-300">
      <button
        class="cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 py-1.5 text-[11px] text-neutral-content transition-colors hover:text-base-content data-[active=true]:border-primary data-[active=true]:text-base-content"
        data-active={@feed_tab == :feed}
        phx-click="set_feed_tab"
        phx-value-tab="feed"
      >
        Feed
      </button>
      <button
        class="cursor-pointer border-0 border-b-2 border-transparent bg-transparent px-3 py-1.5 text-[11px] text-neutral-content transition-colors hover:text-base-content data-[active=true]:border-primary data-[active=true]:text-base-content"
        data-active={@feed_tab == :copilot}
        phx-click="set_feed_tab"
        phx-value-tab="copilot"
      >
        Copilot
      </button>
    </div>
    <div class="min-h-0 flex-1 overflow-hidden">
      <%= if @feed_tab == :feed do %>
        <div class="flex h-full min-h-0 flex-col gap-3 overflow-y-auto p-3">
          <div class="rounded-box border border-base-300/80 bg-base-100/60 p-3">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-neutral-content">
              Activity Feed
            </p>
            <p class="mt-2 text-sm leading-6 text-base-content">
              Proposal cards and review activity will appear here.
            </p>
            <p class="mt-1 text-xs leading-5 text-neutral-content">
              The Copilot tab now hosts the integrated project chat workspace.
            </p>
          </div>
        </div>
      <% else %>
        <FoundryWeb.ChatComponents.studio_panel
          messages={@messages}
          loading={@loading}
          error={@error}
          project_root={@project_root}
          show_system_context={@show_system_context}
          system_context_prompt={@system_context_prompt}
          system_context_error={@system_context_error}
          llm_provider={@llm_provider}
          llm_diagnostics={@llm_diagnostics}
          chat_view={@chat_view}
          activity_runs={@activity_runs}
          selected_activity_run_id={@selected_activity_run_id}
          session_digest={@session_digest}
        />
      <% end %>
    </div>
  </div>
</div>
